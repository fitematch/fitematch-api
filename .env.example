# APP
# -----------------------------------
# Host port bound to the API container:
APPLICATION_BIND_PORT=3000
# API container port:
APPLICATION_PORT=3000


# DATABASE
# -----------------------------------
# MongoDB database URI:
DATABASE_URI=mongodb://database:27017/fitematch
# MongoDB database schema:
DATABASE_NAME=fitematch
# MongoDB host bind port:
DATABASE_BIND_PORT=27017
# MongoDB container port:
DATABASE_PORT=27017


# JWT
# -----------------------------------
# JWT secret used to sign access tokens:
JWT_SECRET=dev-secret-change-me
# JWT secret used to sign refresh tokens:
JWT_REFRESH_SECRET=refresh-secret-change-me
# JWT access token expiration time (e.g., '1d' for 1 day, '2h' for 2 hours):
JWT_EXPIRES_IN=1d
# JWT refresh token expiration time (e.g., '7d' for 7 days, '1m' for 1 month):
JWT_REFRESH_EXPIRES_IN=7d


# AUTH
# -----------------------------------
# Activation code expiration time in minutes:
ACTIVATION_CODE_EXPIRES_IN_MINUTES=60


# AWS
# -----------------------------------
# AWS region:
AWS_REGION=sa-east-1
# AWS access key ID:
AWS_ACCESS_KEY_ID=ACCESS_KEY_ID
# AWS secret access key:
AWS_SECRET_ACCESS_KEY=SECRET_ACCESS_KEY


# AWS S3 
# -----------------------------------
# File upload provider driver:
UPLOAD_PROVIDER_DRIVER=s3
# AWS S3 region:
AWS_S3_REGION=sa-east-1
# AWS S3 bucket name:
AWS_S3_BUCKET=fitematch-development
# File upload provider driver:
AWS_S3_PUBLIC_BASE_URL=https://fitematch-development.s3.sa-east-1.amazonaws.com


# AWS SES
# -----------------------------------
# Email provider driver:
EMAIL_PROVIDER_DRIVER=aws-ses
# AWS SES region:
AWS_SES_REGION=sa-east-1
# The email address that will appear as the sender in AWS SES emails:
AWS_SES_SENDER_EMAIL=no-reply@fitematch.com.br
# The name that will appear as the sender in the emails sent by AWS SES:
AWS_SES_SENDER_NAME=fitematch