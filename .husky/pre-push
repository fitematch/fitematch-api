#!/usr/bin/env sh

echo ""
echo "🧪 Running backend checks before push..."
echo ""

echo "🔍 Running ESLint..."
npm run lint

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Lint failed."
  echo ""
  exit 1
fi

echo ""
echo "📘 Running TypeScript type check..."
npm run type-check

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Type check failed."
  echo ""
  exit 1
fi

echo ""
echo "🧪 Running tests..."
npm run test

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests failed."
  echo ""
  exit 1
fi

echo ""
echo "🏗️ Running build..."
npm run build

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Build failed."
  echo ""
  exit 1
fi

echo ""
echo "🚀 Pre-push passed successfully."
echo ""